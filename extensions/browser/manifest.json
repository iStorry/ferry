{
  "manifest_version": 3,
  "name": "Ferry Browser Link",
  "version": "1.0.0",
  "description": "Download with Ferry: sends a link you choose to the Ferry app, with this browser's cookies for that link's site.",
  "key": "",
  "icons": { "128": "icons/icon128.png" },
  "permissions": ["contextMenus", "cookies", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" }
}
