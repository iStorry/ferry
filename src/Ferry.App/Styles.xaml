<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared look, after docs/mocks (system.html shows it all). The rules every page keeps to:
  - colour means something is moving or connected: bars, graphs and live states take the accent, everything else stays in ink;
    coral is for real problems, amber for waiting and caution
  - the one main action on a screen is ink (AccentButtonStyle): the accent is not for buttons
  - corners: 8 controls, 12 cards and rows, 16 sheets; icon tiles are app-icon shaped (28/8, 36/10, 56/16); pills are half their height
  - type: Figure 48, Title 28, Subtitle 20, Body 14, Caption 12, in Segoe UI Variable, with numbers tabular where they change
  - spacing: steps of 4 (2 within a tight stack of text); controls on one line share a height (32)
  - edges: a page's content starts 32 in; a row's starts and ends 16 inside its card
  - settings are rows in one card with lines between (SetCardStyle and SetRowStyle), not a card for each
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- dark -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="FerryWindowBrush" Color="#E00F1216" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#14181D" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1A1F25" />
            <SolidColorBrush x:Key="FerryCardHoverBrush" Color="#20262D" />
            <SolidColorBrush x:Key="FerrySunkBrush" Color="#33000000" />
            <SolidColorBrush x:Key="FerryRaisedBrush" Color="#20262D" />
            <LinearGradientBrush x:Key="CardStrokeColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1CFFFFFF" Offset="0" />
                <GradientStop Color="#12FFFFFF" Offset="0.08" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#13FFFFFF" />
            <SolidColorBrush x:Key="FerryLineStrongBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F3F5F7" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9B2BD" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#808A96" />
            <SolidColorBrush x:Key="FerryInkBrush" Color="#F3F5F7" />
            <SolidColorBrush x:Key="FerryOnInkBrush" Color="#101317" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF8A80" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#21FF8A80" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#E8B54F" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#24E8B54F" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#72CF9B" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#2172CF9B" />
            <Color x:Key="ProgressBarPausedForegroundColor">#E8B54F</Color>
            <Color x:Key="ProgressBarErrorForegroundColor">#FF8A80</Color>

            <!-- the main action is ink -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#F3F5F7" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D6DAE0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#BCC2CA" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#101317" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#101317" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#101317" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#808A96" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#20262D" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#20262D" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#13FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#24FFFFFF" />

            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#1A1F25" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#1A1F25" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#13FFFFFF" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#13FFFFFF" />

            <!-- a list's selection is a quiet fill, with no bar of accent: nothing about it is moving -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FerryWindowBrush" Color="#E0EEF0F2" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FerryCardHoverBrush" Color="#F6F7F8" />
            <SolidColorBrush x:Key="FerrySunkBrush" Color="#0910141A" />
            <SolidColorBrush x:Key="FerryRaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1610141A" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#1610141A" />
            <SolidColorBrush x:Key="FerryLineStrongBrush" Color="#2610141A" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0B10141A" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1410141A" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#12161B" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#57606B" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6B7480" />
            <SolidColorBrush x:Key="FerryInkBrush" Color="#12161B" />
            <SolidColorBrush x:Key="FerryOnInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C9362A" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#21C9362A" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#A15F05" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#24A15F05" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#1F7A4D" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#211F7A4D" />
            <Color x:Key="ProgressBarPausedForegroundColor">#A15F05</Color>
            <Color x:Key="ProgressBarErrorForegroundColor">#C9362A</Color>

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#12161B" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2C3239" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#3D444C" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#1410141A" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#6B7480" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#1610141A" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#2610141A" />

            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#1610141A" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#1610141A" />

            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1410141A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1A10141A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0F10141A" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
        </ResourceDictionary>

        <!-- high contrast: the system's colours, with none of the above -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FerryWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FerryCardHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FerrySunkBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FerryRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FerryLineStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FerryInkBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FerryOnInkBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- every page's content starts 32 in and 24 down (16 in a narrow window), so moving between pages nothing jumps -->
    <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="NarrowPagePadding">16,20,16,16</Thickness>

    <!-- Fluent's Title, tightened, without the trim it gives a letter's side: that puts a D or a P to the left of the text and cards under it -->
    <Style x:Key="HeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="OpticalMarginAlignment" Value="None" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>

    <Style x:Key="SubheadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="OpticalMarginAlignment" Value="None" />
        <Setter Property="CharacterSpacing" Value="-12" />
    </Style>

    <!-- the big figure: how fast -->
    <Style x:Key="FigureStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="LineHeight" Value="52" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="OpticalMarginAlignment" Value="None" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- with the 4 between a page's rows: 24 above, 8 below -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,20,0,4" />
    </Style>

    <Style x:Key="CaptionMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionFaintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- a card on its own, padded: what most rows of facts sit in -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="60" />
    </Style>

    <!-- rows grouped in one card, with lines between: the card -->
    <Style x:Key="SetCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- a row in such a card; each after the first has a line above (SettingRows.Group sets it) -->
    <Style x:Key="SetRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- a short fact as a pill; half its height at the corners -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- the box in the title bar: its text starts after the search icon, and stops before the shortcut -->
    <Style x:Key="CommandTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
        <Setter Property="Padding" Value="34,5,60,6" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- a place in the window's sidebar: an icon, its name, and what is going on there. Showing: a quiet fill and a stronger name -->
    <Style x:Key="PlaceItemStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Places" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Selected.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- apart from the background the pointer states set, so being here and being pointed at both show -->
                        <Border x:Name="Selected" CornerRadius="{TemplateBinding CornerRadius}" Visibility="Collapsed"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}" />
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}" FontSize="13.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a section in a page's own list on its left (Settings): as a place in the sidebar, a little smaller -->
    <Style x:Key="SubnavItemStyle" TargetType="RadioButton" BasedOn="{StaticResource PlaceItemStyle}">
        <Setter Property="GroupName" Value="Subnav" />
        <Setter Property="Height" Value="34" />
    </Style>

    <!-- what sits in a segmented control (SegmentsStyle): one chosen, as a raised chip -->
    <Style x:Key="SegmentItemStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Visibility" Value="Visible" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Chip" CornerRadius="{TemplateBinding CornerRadius}" Visibility="Collapsed" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}" FontSize="13" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the well a segmented control's items sit in -->
    <Style x:Key="SegmentsStyle" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- a card that is a button: the sidebar's foot, About's links -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource FerryCardHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource FerryCardHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- a row's small action: smaller than a page's buttons, as there are many of them -->
    <Style x:Key="RowActionStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <!-- a list that holds rows of its own look: no padding or lines of the list's, and only a quiet fill for what is selected -->
    <Style x:Key="PlainListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</ResourceDictionary>
