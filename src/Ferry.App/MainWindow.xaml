<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ferry.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Ferry.App.Services"
    Title="Ferry">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="{ThemeResource FerryWindowBrush}" SizeChanged="OnRootSizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnCommandAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the title bar: the command box takes clicks (a passthrough region); the rest drags the window -->
        <Grid x:Name="AppTitleBar" SizeChanged="OnTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleColumn" Width="208" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="20,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="Ferry" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>
            <!-- one box for everything typed or pasted, with the search icon before the text and the shortcut after it -->
            <Grid x:Name="CommandArea" Grid.Column="1" MaxWidth="560" VerticalAlignment="Center" Margin="12,0" Visibility="Collapsed">
                <AutoSuggestBox x:Name="CommandBox" PlaceholderText="Paste a link or run a command" UpdateTextOnSelect="False"
                                TextBoxStyle="{StaticResource CommandTextBoxStyle}"
                                AutomationProperties.Name="Paste a link or run a command"
                                TextChanged="OnCommandTextChanged" QuerySubmitted="OnCommandSubmitted"
                                SizeChanged="OnTitleBarControlSizeChanged">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="services:CommandItem">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                                    <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind ShowDetail}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionFaintStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Keys}" VerticalAlignment="Center" Style="{StaticResource CaptionFaintStyle}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Border x:Name="CommandShortcut" Margin="0,0,8,0" Padding="5,0" CornerRadius="4" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsHitTestVisible="False" BorderBrush="{ThemeResource FerryLineStrongBrush}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="Ctrl K" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Border>
            </Grid>
        </Grid>

        <!-- shown as the session opens: until then nothing here could say anything true -->
        <Grid x:Name="Body" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the sidebar: where to go, what is going on there, and where downloads happen -->
            <Grid Padding="10,4,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="PlacesTop" Spacing="2">
                    <RadioButton x:Name="DownloadsItem" Tag="Downloads" Style="{StaticResource PlaceItemStyle}" Checked="OnPlaceChecked" Click="OnPlaceClicked"
                                 AutomationProperties.Name="Downloads">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20">
                                <!-- the queue's overall progress, around the icon while files download -->
                                <ProgressRing x:Name="QueueRing" Width="28" Height="28" Margin="-4" IsIndeterminate="False" Maximum="1" Visibility="Collapsed" />
                                <FontIcon x:Name="DownloadsGlyph" Glyph="&#xE896;" FontSize="16" />
                                <Ellipse x:Name="DownloadsDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                         Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="Downloads" Tag="wide" />
                            <!-- how many are active, or in coral how many need the user -->
                            <TextBlock x:Name="DownloadsCount" Grid.Column="2" Tag="wide" FontSize="12" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                        </Grid>
                    </RadioButton>

                    <!-- what plugins add, while they are on and in use -->
                    <TextBlock x:Name="AddedLabel" Text="Added by plugins" Style="{StaticResource CaptionFaintStyle}" Margin="10,14,0,4" Tag="wide" Visibility="Collapsed" />
                    <Rectangle x:Name="AddedLine" Height="1" Margin="8,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />
                    <RadioButton x:Name="BrowserItem" Tag="Browser" Style="{StaticResource PlaceItemStyle}" Checked="OnPlaceChecked" Click="OnPlaceClicked"
                                 AutomationProperties.Name="Browser" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20">
                                <FontIcon Glyph="&#xF0E2;" FontSize="16" />
                                <Ellipse x:Name="WatchDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                         Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="Browser" Tag="wide" />
                            <!-- files added to watched albums since they were last looked at -->
                            <InfoBadge x:Name="WatchBadge" Grid.Column="2" Tag="wide" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="LibraryItem" Tag="Library" Style="{StaticResource PlaceItemStyle}" Checked="OnPlaceChecked" Click="OnPlaceClicked"
                                 AutomationProperties.Name="Library" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Library" Tag="wide" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="ServerItem" Tag="Server" Style="{StaticResource PlaceItemStyle}" Checked="OnPlaceChecked" Click="OnPlaceClicked"
                                 AutomationProperties.Name="Server" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE839;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Server" Tag="wide" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <StackPanel x:Name="PlacesBottom" Grid.Row="2" Spacing="2">
                    <RadioButton x:Name="PluginsItem" Tag="Plugins" Style="{StaticResource PlaceItemStyle}" Checked="OnPlaceChecked" Click="OnPlaceClicked"
                                 AutomationProperties.Name="Plugins">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA86;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Plugins" Tag="wide" />
                            <TextBlock x:Name="PluginsCount" Grid.Column="2" Tag="wide" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="SettingsItem" Tag="Settings" Style="{StaticResource PlaceItemStyle}" Checked="OnPlaceChecked" Click="OnPlaceClicked"
                                 AutomationProperties.Name="Settings">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Settings" Tag="wide" />
                        </Grid>
                    </RadioButton>
                    <!-- a decoy has no Settings to reach it from -->
                    <RadioButton x:Name="AboutItem" Tag="About" Style="{StaticResource PlaceItemStyle}" Checked="OnPlaceChecked" Click="OnPlaceClicked"
                                 AutomationProperties.Name="About" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="About" Tag="wide" />
                        </Grid>
                    </RadioButton>

                    <!-- an update is ready: a quiet line, not a badge -->
                    <Button x:Name="UpdateLine" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Height="30" Padding="10,0" Margin="0,4,0,0" Click="OnUpdateLine" Visibility="Collapsed" Tag="wide">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="UpdateText" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="WhereCard" Style="{StaticResource CardButtonStyle}" Click="OnWhereCardClick" Margin="0,8,0,0">
                        <StackPanel Spacing="2">
                            <Grid x:Name="WhereTop" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <FontIcon x:Name="ModeIcon" Glyph="&#xE7F8;" FontSize="14" />
                                    <Ellipse x:Name="ModeDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" />
                                    <!-- in place of the dot while the connection is being made or closed -->
                                    <ProgressRing x:Name="ModeSpinner" Width="10" Height="10" MinWidth="0" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                  Margin="0,-3,-3,0" IsActive="False" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="ModeTitle" Grid.Column="1" Tag="wide" Text="This PC" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </Grid>
                            <TextBlock x:Name="ModeDetail" Tag="wide" Margin="24,0,0,0" Style="{StaticResource CaptionMutedStyle}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <ProgressBar x:Name="ModeSpace" Tag="wide" Margin="0,8,0,0" Height="3" MinHeight="3" Maximum="1" Visibility="Collapsed"
                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="ModeFree" Tag="wide" Margin="0,4,0,0" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- the page area: a lighter layer with a rounded top-left corner, as WinUI 3's own windows have -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="12,0,0,0">
                <Frame x:Name="ContentFrame" />
            </Border>
        </Grid>

        <!-- the first run, over the whole window -->
        <Frame x:Name="WelcomeFrame" Grid.Row="1" Visibility="Collapsed" />

        <!-- the app lock's PIN, over the whole window, before anything else is loaded -->
        <Frame x:Name="LockFrame" Grid.Row="1" Visibility="Collapsed" />

        <!-- closing: what Ferry is finishing before it goes (pausing), over everything -->
        <Grid x:Name="ClosingOverlay" Grid.Row="1" Visibility="Collapsed">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.92" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
                <ProgressRing x:Name="ClosingRing" Width="32" Height="32" IsActive="False" HorizontalAlignment="Center" />
                <TextBlock x:Name="ClosingText" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="ClosingDetail" Style="{StaticResource CaptionMutedStyle}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
