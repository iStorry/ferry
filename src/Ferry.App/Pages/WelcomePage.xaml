<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Ferry.App.Pages"
    xmlns:services="using:Ferry.App.Services"
    xmlns:vm="using:Ferry.App.ViewModels">
    <Page.Resources>
        <!-- a choice as a card, one of them picked: a 2 px outline in ink -->
        <Style x:Key="ChoiceCardStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="WhereToDownload" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource FerryCardHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource FerryCardHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Outline.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Top"
                                              Foreground="{TemplateBinding Foreground}" />
                            <!-- over the card's own edge -->
                            <Border x:Name="Outline" Margin="-1" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2" Visibility="Collapsed"
                                    BorderBrush="{ThemeResource FerryInkBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the first run in a wide window: a harbour before dawn, in the brand's colours whichever theme is on, with what Ferry is and the steps (docs/mocks/welcome.html) -->
        <Grid x:Name="Brand" Width="372" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#08171F" Offset="0" />
                    <GradientStop Color="#0C3440" Offset="0.48" />
                    <GradientStop Color="#1E7F7C" Offset="0.72" />
                    <GradientStop Color="#E8B58A" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- the sea, over the last part of the panel, wave behind wave -->
            <Grid IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72*" />
                    <RowDefinition Height="28*" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="1" Stretch="Fill">
                    <Canvas Width="372" Height="200">
                        <Path Fill="#0D4A55" Opacity="0.78" Data="M0,40 c40,-12 76,-12 116,0 s76,12 116,0 s100,-12 140,0 v160 H0 Z" />
                        <Path Fill="#0A3340" Opacity="0.9" Data="M0,92 c46,-14 84,-14 124,0 s84,14 124,0 s84,-14 124,0 v108 H0 Z" />
                        <Path Fill="#071F28" Data="M0,144 c46,-12 84,-12 124,0 s84,12 124,0 s84,-12 124,0 v56 H0 Z" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <StackPanel Padding="28,32,28,24">
                <Border Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Left" Margin="0,0,0,22">
                    <Border.Background>
                        <ImageBrush ImageSource="ms-appx:///Assets/AppIcon.png" />
                    </Border.Background>
                </Border>
                <TextBlock Text="Downloads that keep going." Foreground="White" TextWrapping="Wrap" FontSize="34" LineHeight="40" FontWeight="SemiBold" CharacterSpacing="-26"
                           OpticalMarginAlignment="None" />
                <TextBlock Foreground="#C7FFFFFF" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Paste a link. Ferry downloads it here, or on your own server while this PC sleeps." />
                <ItemsControl x:Name="BrandSteps" IsTabStop="False" Margin="0,28,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetupStep">
                            <StackPanel Orientation="Horizontal" Spacing="10" Height="32" Margin="0,0,0,2" Opacity="{x:Bind Emphasis}">
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse Stroke="#66FFFFFF" StrokeThickness="1.5" />
                                    <Ellipse Visibility="{x:Bind Done}" Fill="#3DFFFFFF" />
                                    <TextBlock Text="{x:Bind Mark}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Grid Visibility="{x:Bind CurrentMark}">
                                        <Ellipse Fill="White" />
                                        <TextBlock Text="{x:Bind Mark}" FontSize="11" FontWeight="SemiBold" Foreground="#0C3440"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" FontSize="13" Foreground="White" VerticalAlignment="Center"
                                           FontWeight="{x:Bind pages:WelcomePage.StepWeight(Current)}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" />

        <ScrollViewer x:Name="ChoosePage" Grid.Column="1">
            <Grid Padding="48,40,48,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="640" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel>

                    <!-- where to download -->
                    <StackPanel x:Name="ChoosePanel">
                        <TextBlock Text="Where should Ferry download?" Style="{StaticResource HeadingStyle}" />
                        <TextBlock Text="You can change this later in Settings." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,20" />
                        <Grid x:Name="Choices" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Style="{StaticResource ChoiceCardStyle}" IsChecked="True" AutomationProperties.Name="On this PC">
                                <StackPanel Spacing="6">
                                    <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Left" Margin="0,0,0,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xE7F8;" FontSize="26" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="On this PC" FontSize="16" LineHeight="22" FontWeight="SemiBold" />
                                    <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Nothing else to set up. Files go straight to your folder. Downloads pause while the PC is off." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ServerChoice" Grid.Column="1" Style="{StaticResource ChoiceCardStyle}" AutomationProperties.Name="On your server">
                                <StackPanel Spacing="6">
                                    <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Left" Margin="0,0,0,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xE839;" FontSize="26" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="On your server" FontSize="16" LineHeight="22" FontWeight="SemiBold" />
                                    <TextBlock FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Keeps going while this PC is off. Any Linux server you can reach with SSH. Finished files come here, checked. Adds Server Support." />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <Button Content="Continue" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Margin="0,20,0,0" Click="OnChooseNext" />
                    </StackPanel>

                    <!-- where files go, and the plugins: they are options, so none is added without asking here -->
                    <StackPanel x:Name="PlanPanel" Visibility="Collapsed" Spacing="4">
                        <TextBlock x:Name="PlanTitle" Style="{StaticResource HeadingStyle}" />
                        <TextBlock x:Name="PlanLead" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <TextBlock Text="Files go to" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- the folder is chosen with the button, so this only reads like a box -->
                            <Border Height="32" Padding="11,0" CornerRadius="8" BorderThickness="1" Background="{ThemeResource FerrySunkBrush}" BorderBrush="{ThemeResource FerryLineStrongBrush}">
                                <TextBlock x:Name="LocalFolder" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Download folder" />
                            </Border>
                            <Button Grid.Column="1" Content="Change…" Click="OnChangeFolder" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Plugins" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Border Style="{StaticResource CardStyle}" MinHeight="0" Padding="12,10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ServerTile" Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center">
                                        <FontIcon x:Name="ServerIcon" Glyph="&#xE839;" FontSize="16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Server Support" FontSize="13.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ServerWhat" Style="{StaticResource CaptionMutedStyle}" />
                                    </StackPanel>
                                    <services:LabeledSwitch x:Name="ServerAdd" Grid.Column="2" Caption="" VerticalAlignment="Center" AccessibleName="Server Support" Toggled="OnPluginChosen" />
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Text="It comes with Ferry, so adding it downloads nothing. You can change this any time in Plugins."
                                   Style="{StaticResource CaptionMutedStyle}" Margin="0,4,0,0" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Back" Click="OnBackToChoose" />
                            <Button x:Name="PlanNext" Style="{StaticResource AccentButtonStyle}" Click="OnPlanNext" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- the server's steps, in the same place -->
        <Frame x:Name="SetupFrame" Grid.Column="1" Visibility="Collapsed" />
    </Grid>
</Page>
