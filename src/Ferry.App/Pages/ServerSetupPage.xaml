<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.ServerSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Ferry.App.Services"
    xmlns:vm="using:Ferry.App.ViewModels">
    <Grid>
        <ScrollViewer>
            <Grid x:Name="Body" Padding="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="640" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel>

                    <ItemsControl x:Name="Stepper" IsTabStop="False" Margin="0,0,0,20" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <services:WrapRow Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStep">
                                <Grid Opacity="{x:Bind Emphasis}">
                                    <Border Visibility="{x:Bind CurrentMark}" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,6">
                                        <Grid Width="20" Height="20">
                                            <Border CornerRadius="10" BorderThickness="1.5" BorderBrush="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind Mark}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Visibility="{x:Bind CurrentMark}" CornerRadius="10" Background="{ThemeResource FerryInkBrush}">
                                                <TextBlock Text="{x:Bind Mark}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource FerryOnInkBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- server: login -->
                    <StackPanel x:Name="ServerPanel" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Your server" Style="{StaticResource HeadingStyle}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Any Linux server you can log in to with SSH (x64 or arm64). Ferry logs in once with your password and swaps it for a key of its own; the password isn't saved. Nothing runs as root and no port is opened." />
                        </StackPanel>
                        <InfoBar x:Name="SshProblem" Visibility="{x:Bind SshProblem.IsOpen, Mode=OneWay}" Severity="Error" IsClosable="False" IsOpen="False" Title="OpenSSH isn't ready" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="460" />
                                <ColumnDefinition Width="0" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HostBox" Header="Server" PlaceholderText="host name or address" />
                                    <NumberBox x:Name="PortBox" Grid.Column="1" Header="Port" Value="22" Minimum="1" Maximum="65535" />
                                </Grid>
                                <TextBox x:Name="UserBox" Header="User" />
                                <Border Style="{StaticResource SegmentsStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <RadioButton GroupName="LoginWith" Style="{StaticResource SegmentItemStyle}" IsChecked="True" AutomationProperties.Name="Log in with a password">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                                <TextBlock Text="Password" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="LoginKey" GroupName="LoginWith" Style="{StaticResource SegmentItemStyle}" AutomationProperties.Name="Log in with a key file"
                                                     Checked="OnLoginChoice" Unchecked="OnLoginChoice">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                                <TextBlock Text="Key file" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <PasswordBox x:Name="PasswordBox" PlaceholderText="Password" AutomationProperties.Name="Password" />
                                <Grid x:Name="KeyPanel" ColumnSpacing="8" Visibility="Collapsed" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="KeyFileBox" PlaceholderText="C:\Users\you\.ssh\id_ed25519" AutomationProperties.Name="Key file" />
                                    <Button Grid.Column="1" Content="Browse…" Click="OnBrowseKey" />
                                    <PasswordBox x:Name="PassphraseBox" Grid.Row="1" Grid.ColumnSpan="2" PlaceholderText="Passphrase, if the key has one" AutomationProperties.Name="Key passphrase" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CaptionMutedStyle}" Text="OpenSSH format, used where it is." />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <InfoBar x:Name="FormError" Visibility="{x:Bind FormError.IsOpen, Mode=OneWay}" Severity="Error" IsClosable="True" IsOpen="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="ServerBack" Content="Back" Click="OnBack" />
                            <Button Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="OnConnect" />
                        </StackPanel>
                    </StackPanel>

                    <!-- server: the host key -->
                    <StackPanel x:Name="HostKeyPanel" Visibility="Collapsed" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Is this your server?" Style="{StaticResource HeadingStyle}" />
                            <TextBlock x:Name="HostKeyLead" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="0" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" MinHeight="0" Padding="14,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xEA18;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Key fingerprint" Style="{StaticResource CaptionMutedStyle}" />
                                        <TextBlock x:Name="Fingerprint" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionMutedStyle}" Text="On the server, ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub prints it." />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Cancel" Click="OnDistrust" />
                            <Button x:Name="TrustButton" Content="Trust and continue" Style="{StaticResource AccentButtonStyle}" Click="OnTrust" />
                        </StackPanel>
                    </StackPanel>

                    <!-- server: setting up, failed -->
                    <StackPanel x:Name="WorkingPanel" Visibility="Collapsed" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Setting up your server" Style="{StaticResource HeadingStyle}" />
                            <TextBlock Text="This takes a minute; the agent is about 15 MB." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <InfoBar x:Name="SetupError" Visibility="{x:Bind SetupError.IsOpen, Mode=OneWay}" Severity="Error" IsClosable="False" IsOpen="False" Title="Setup stopped. Nothing was saved on this PC." />
                        <!-- the checks so far, as rows in one card -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="560" />
                                <ColumnDefinition Width="0" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TasksCard" Style="{StaticResource SetCardStyle}" Visibility="Collapsed">
                                <StackPanel x:Name="Tasks" />
                            </Border>
                        </Grid>
                        <Button x:Name="CancelSetup" Content="Cancel" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnCancelSetup" Visibility="Collapsed" />
                        <StackPanel x:Name="FailedButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed">
                            <Button Content="Back" Click="OnBack" />
                            <Button Content="Try again" Style="{StaticResource AccentButtonStyle}" Click="OnTryAgain" />
                        </StackPanel>
                    </StackPanel>

                    <!-- server: done -->
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server mode is on" Style="{StaticResource HeadingStyle}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Links you add are downloaded by your server, then brought to this PC and checked. Closing Ferry doesn't stop them." />
                        </StackPanel>
                        <InfoBar x:Name="DoneBar" Severity="Success" IsClosable="False" IsOpen="True" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid x:Name="Summary" ColumnSpacing="16" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>
                        <Button x:Name="FinishButton" Content="Start downloading" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnFinish" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
