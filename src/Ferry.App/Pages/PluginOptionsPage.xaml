<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.PluginOptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Ferry.App.Pages"
    xmlns:services="using:Ferry.App.Services"
    SizeChanged="OnSizeChanged">
    <!-- docs/mocks/plugins.html: every plugin's page has the same parts: what it reads, its keys, its options, what it can't do yet -->
    <ScrollViewer>
        <StackPanel x:Name="PageLayout" Padding="{StaticResource PagePadding}" Spacing="4">
            <pages:PluginHeader x:Name="Header" Toggled="OnToggled" />

            <StackPanel x:Name="ReadsGroup" Spacing="8">
                <TextBlock Text="What it reads" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,0" />
                <services:WrapRow x:Name="Reads" Spacing="6" />
            </StackPanel>

            <StackPanel x:Name="KeysGroup" Spacing="4">
                <TextBlock Text="Keys and logins" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SetCardStyle}"><StackPanel x:Name="KeyRows" /></Border>
            </StackPanel>

            <StackPanel x:Name="OptionsGroup" Spacing="4">
                <TextBlock Text="Options" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SetCardStyle}"><StackPanel x:Name="Rows" /></Border>
            </StackPanel>

            <StackPanel x:Name="LimitsGroup" Spacing="4">
                <TextBlock Text="Good to know" Style="{StaticResource SectionHeaderStyle}" />
                <Border CornerRadius="12" Padding="14,12" BorderThickness="1" Background="{ThemeResource FerrySunkBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel x:Name="Limits" Grid.Column="1" Spacing="4" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="InstalledGroup" Spacing="4">
                <TextBlock Text="Installed" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SetCardStyle}"><StackPanel x:Name="InstalledRows" /></Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
