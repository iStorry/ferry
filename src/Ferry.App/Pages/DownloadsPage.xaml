<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Ferry.App.Services"
    xmlns:vm="using:Ferry.App.ViewModels"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden"
    NavigationCacheMode="Required"
    SizeChanged="OnSizeChanged">

    <Page.Resources>
        <!-- the queue in sections (Needs you, Now, Up next, Paused, Done): only those with files, so an empty one takes no room -->
        <CollectionViewSource x:Name="Sections" IsSourceGrouped="True" />

        <!-- a file: its kind, what it is and which plugin read it, its bar in a column of its own (under the words when there
             is no room), its speed and time, and what can be done, which shows on hover -->
        <DataTemplate x:Key="FileTemplate" x:DataType="vm:ItemViewModel">
            <Grid ColumnSpacing="14" Margin="{x:Bind RowMargin, Mode=OneWay}" Padding="14,10,8,10"
                  CornerRadius="{x:Bind RowCorners, Mode=OneWay}" BorderThickness="{x:Bind RowBorder, Mode=OneWay}"
                  Background="{x:Bind RowBackground, Mode=OneWay}" BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}"
                  PointerEntered="OnRowEntered" PointerExited="OnRowExited" PointerCanceled="OnRowExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Bind ProgressWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind FigureWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="Auto" MinWidth="58" />
                </Grid.ColumnDefinitions>
                <!-- star, so what spans both rows doesn't push the second open while it has nothing in it -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" Width="{x:Bind TileSize, Mode=OneWay}" Height="{x:Bind TileSize, Mode=OneWay}" CornerRadius="{x:Bind TileCorners, Mode=OneWay}"
                        VerticalAlignment="Center" Background="{x:Bind KindBackground, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind KindGlyph, Mode=OneWay}" FontSize="{x:Bind TileGlyphSize, Mode=OneWay}" Foreground="{x:Bind KindBrush, Mode=OneWay}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Foreground="{x:Bind DetailBrush, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind Meta, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="{x:Bind DetailLines, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="{x:Bind ProgressColumn, Mode=OneWay}" Grid.Row="{x:Bind ProgressRow, Mode=OneWay}" VerticalAlignment="Center"
                            Margin="{x:Bind ProgressMargin, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Percent, Mode=OneWay}" Visibility="{x:Bind ShowPercent, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" Margin="0,0,0,4"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular" />
                    <ProgressBar Visibility="{x:Bind ShowBar, Mode=OneWay}" Value="{x:Bind Progress, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}" ShowPaused="{x:Bind Paused, Mode=OneWay}"
                                 ShowError="{x:Bind Failed, Mode=OneWay}" Foreground="{x:Bind BarBrush, Mode=OneWay}" />
                    <!-- server mode: one bar in two parts, the server's download and then the trip here -->
                    <Grid Visibility="{x:Bind ShowSteps, Mode=OneWay}" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ServerText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{x:Bind ServerValue, Mode=OneWay}" Foreground="{x:Bind ServerBrush, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,-3" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{x:Bind PcText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{x:Bind PcValue, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" Visibility="{x:Bind ShowFigures, Mode=OneWay}">
                    <TextBlock Text="{x:Bind FigureTop, Mode=OneWay}" Visibility="{x:Bind ShowFigureTop, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{x:Bind FigureBottom, Mode=OneWay}" Foreground="{x:Bind StateBrush, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                </StackPanel>

                <StackPanel Grid.Column="4" Grid.RowSpan="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Opacity="{x:Bind ActionsOpacity, Mode=OneWay}">
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause" Click="OnPause" Visibility="{x:Bind CanPause, Mode=OneWay}">
                        <FontIcon Glyph="&#xE769;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="Resume" AutomationProperties.Name="Resume" Click="OnResume" Visibility="{x:Bind CanResume, Mode=OneWay}">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="Cancel" AutomationProperties.Name="Cancel" Click="OnCancel" Visibility="{x:Bind ShowCancel, Mode=OneWay}">
                        <FontIcon Glyph="&#xE71A;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="Retry" AutomationProperties.Name="Retry" Click="OnRetry" Visibility="{x:Bind ShowRetry, Mode=OneWay}">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="Open folder" AutomationProperties.Name="Open folder" Click="OnOpenFolder" Visibility="{x:Bind ShowOpenFolder, Mode=OneWay}">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="More" AutomationProperties.Name="More" Click="OnMore">
                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- an album's or a folder's files go to one folder, so they show together in one card, under this -->
        <DataTemplate x:Key="AlbumTemplate" x:DataType="vm:AlbumGroupViewModel">
            <Grid ColumnSpacing="14" Margin="0,8,0,0" Padding="14,12,8,12" CornerRadius="12,12,0,0" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Bind ProgressWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind FigureWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="Auto" MinWidth="58" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center" Background="{x:Bind Cover}">
                    <TextBlock Text="{x:Bind Initial}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                    <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="{x:Bind ProgressColumn, Mode=OneWay}" Grid.Row="{x:Bind ProgressRow, Mode=OneWay}" VerticalAlignment="Center"
                            Margin="{x:Bind ProgressMargin, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Percent, Mode=OneWay}" Visibility="{x:Bind ShowPercent, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" Margin="0,0,0,4"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular" />
                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" ShowPaused="{x:Bind IsStopped}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" Visibility="{x:Bind ShowFigures, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Speed, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{x:Bind Size, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <StackPanel Grid.Column="4" Grid.RowSpan="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="{x:Bind ActionText}" AutomationProperties.Name="{x:Bind ActionText}" Click="OnPauseAlbum">
                        <FontIcon Glyph="{x:Bind ActionGlyph}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource RowActionStyle}" ToolTipService.ToolTip="Open its folder" AutomationProperties.Name="Open its folder" Click="OnOpenAlbumFolder">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- what is done, at a glance; the files themselves on request -->
        <DataTemplate x:Key="StripTemplate" x:DataType="vm:DoneStripViewModel">
            <Grid ColumnSpacing="14" Margin="0,2" Padding="14,12,8,12" CornerRadius="12" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="OnOpenDownloadFolder" Visibility="{x:Bind CanOpenFolder, Mode=OneWay}" Height="28" Padding="10,0" FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="13" />
                            <TextBlock Text="Open folder" />
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Bind ToggleText, Mode=OneWay}" Click="OnToggleDoneFiles" Style="{StaticResource SubtleButtonStyle}" Height="28" Padding="10,0" FontSize="12" />
                    <Button Content="Clear" Click="OnClearDone" Style="{StaticResource SubtleButtonStyle}" Height="28" Padding="10,0" FontSize="12" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteAccelerator" />
        <KeyboardAccelerator Modifiers="Control,Shift" Key="O" Invoked="OnOpenFolderAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <ListView
            x:Name="List"
            SelectionMode="Extended"
            Padding="32,0,32,24"
            IsItemClickEnabled="False"
            SelectionChanged="OnSelectionChanged"
            ItemContainerStyle="{StaticResource PlainListItemStyle}">

            <ListView.Resources>
                <!-- the row draws its own corners: these would cut a notch where rows in one card meet -->
                <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
            </ListView.Resources>

            <ListView.GroupStyle>
                <GroupStyle>
                    <!-- a section's title on the rows' left edge (WinUI's own header is indented 12), with room above it -->
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!-- WinUI's own draws a line under the title, which the sections here don't have -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewHeaderItem">
                                        <ContentPresenter Margin="0,20,0,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:QueueGroup">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}" Style="{StaticResource CaptionFaintStyle}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.Header>
                <StackPanel Padding="0,24,0,0">
                    <!-- connecting, reconnecting, disconnecting show in the sidebar's card, not here as well -->

                    <!-- no server set up -->
                    <InfoBar x:Name="ServerBar" Title="No server set up" Message="Downloads wait until a server is set up." IsClosable="False" Severity="Warning" Margin="0,0,0,12" IsOpen="False"
                             Visibility="{x:Bind ServerBar.IsOpen, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="Set up a server" Click="OnRetryServer" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- queue.json is there but couldn't be read: an empty list here doesn't mean an empty queue -->
                    <InfoBar x:Name="QueueUnreadBar" Title="Your saved queue couldn't be read" Message="Nothing is being saved over it, so links added now are gone when Ferry closes. Open Ferry again to try again."
                             IsClosable="False" Severity="Warning" Margin="0,0,0,12" IsOpen="False" Visibility="{x:Bind QueueUnreadBar.IsOpen, Mode=OneWay}" />

                    <!-- the server can't be reached (past the grace a drop gets): what that means, in place of how it is going -->
                    <Border x:Name="OfflineHero" Style="{StaticResource CardStyle}" Padding="20,16" Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                                <FontIcon Glyph="&#xE839;" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="OfflineWho" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OfflineWhere" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OfflineDetail" Style="{StaticResource CaptionMutedStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="OnRetryServer">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Try now" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- how it is going: where, how fast, how much is left, over the last minute as a graph -->
                    <Grid x:Name="Hero" CornerRadius="12" BorderThickness="1" Visibility="Collapsed"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="GraphRow" Height="64" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="HeroBody" Padding="20,14,20,0" Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="7" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="HeroIcon" Glyph="&#xE7F8;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HeroWhere" Grid.Column="1" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <DropDownButton x:Name="WhenDoneButton" ToolTipService.ToolTip="What to do when the queue finishes" AutomationProperties.Name="When the queue finishes"
                                                    Background="Transparent" BorderThickness="0" Height="28" Padding="8,0" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE708;" FontSize="13" />
                                            <TextBlock x:Name="WhenDoneText" Text="When done" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout x:Name="WhenDoneMenu" Placement="BottomEdgeAlignedRight" />
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <DropDownButton x:Name="LimitButton" ToolTipService.ToolTip="Speed limit, for all downloads together" AutomationProperties.Name="Speed limit"
                                                    Background="Transparent" BorderThickness="0" Height="28" Padding="8,0" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xEC4A;" FontSize="13" />
                                            <TextBlock x:Name="LimitText" Text="No limit" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout x:Name="LimitMenu" Placement="BottomEdgeAlignedRight" />
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button x:Name="PauseAllButton" Click="OnPauseAll" ToolTipService.ToolTip="Pause all" AutomationProperties.Name="Pause all" Height="28" Padding="10,0" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE769;" FontSize="13" />
                                            <TextBlock x:Name="PauseAllText" Text="Pause all" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ResumeAllButton" Click="OnResumeAll" ToolTipService.ToolTip="Resume all" AutomationProperties.Name="Resume all" Height="28" Padding="10,0" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                                            <TextBlock x:Name="ResumeAllText" Text="Resume all" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HeroFolder" Style="{StaticResource RowActionStyle}" Click="OnOpenDownloadFolder" ToolTipService.ToolTip="Open the download folder (Ctrl+Shift+O)"
                                            AutomationProperties.Name="Open the download folder (Ctrl+Shift+O)">
                                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock x:Name="ThereLabel" Text="On the server" Style="{StaticResource CaptionMutedStyle}" Visibility="Collapsed" />
                                    <TextBlock Style="{StaticResource FigureStyle}" TextWrapping="NoWrap">
                                        <Run x:Name="HeroSpeed" Text="0" />
                                        <Run x:Name="HeroUnit" Text="B/s" FontSize="20" CharacterSpacing="-10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </StackPanel>
                                <FontIcon x:Name="HereArrow" Grid.Column="1" Glyph="&#xE72A;" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,14"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                                <StackPanel x:Name="HereLane" Grid.Column="2" VerticalAlignment="Bottom" Visibility="Collapsed">
                                    <TextBlock Text="Coming here" Style="{StaticResource CaptionMutedStyle}" />
                                    <TextBlock Style="{StaticResource FigureStyle}" TextWrapping="NoWrap">
                                        <Run x:Name="HereSpeed" Text="0" />
                                        <Run x:Name="HereUnit" Text="B/s" FontSize="20" CharacterSpacing="-10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- what the queue is doing, as figures with their words -->
                                <services:WrapRow x:Name="HeroFacts" Grid.Column="3" Spacing="24" VerticalAlignment="Bottom" Margin="8,0,0,7" />
                            </Grid>
                            <!-- the schedule holds what comes here, and the server carries on -->
                            <TextBlock x:Name="HeroNote" Style="{StaticResource CaptionMutedStyle}" Visibility="Collapsed" />
                        </StackPanel>
                        <!-- downloading (accent) and, in server mode, coming here (dashed), drawn by DrawGraph; right to the card's
                             edges, as it fades to nothing before the corners -->
                        <Canvas x:Name="Graph" Grid.Row="1" Margin="1,4,1,1" SizeChanged="OnGraphSizeChanged">
                            <Path x:Name="GraphArea" />
                            <Path x:Name="GraphLine" StrokeThickness="1.75" StrokeLineJoin="Round" />
                            <Path x:Name="GraphHere" StrokeThickness="1.75" StrokeDashArray="3,4" StrokeLineJoin="Round" Stroke="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>

                    <StackPanel x:Name="ReadingLinks" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">
                        <ProgressRing x:Name="ReadingRing" Width="14" Height="14" IsActive="False" VerticalAlignment="Center" />
                        <TextBlock Text="Reading the links" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <InfoBar x:Name="AddResult" IsClosable="True" Margin="0,12,0,0" IsOpen="False" Visibility="{x:Bind AddResult.IsOpen, Mode=OneWay}" />

                    <!-- copied links are offered here, in the page: a quiet line, never a banner over everything -->
                    <Border x:Name="ClipboardOffer" Style="{StaticResource SetCardStyle}" Padding="14,6,6,6" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ClipboardWords" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="Add" Click="OnAddOffered" AutomationProperties.Name="Add copied links" Height="28" Padding="12,0" />
                            <Button Grid.Column="3" Style="{StaticResource RowActionStyle}" Click="OnCloseOffer" AutomationProperties.Name="Close" ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- the queue's parts, each with its count, and a filter over them -->
                    <Grid x:Name="QueueTools" ColumnSpacing="12" Margin="0,20,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalAlignment="Left">
                            <Border Style="{StaticResource SegmentsStyle}">
                                <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="2" />
                            </Border>
                        </ScrollViewer>
                        <TextBox x:Name="FilterBox" Grid.Column="1" PlaceholderText="Filter" Width="168" MinHeight="32" VerticalAlignment="Center" TextChanged="OnFilterChanged"
                                 AutomationProperties.Name="Filter the queue by name" />
                    </Grid>

                    <!-- in the header, not the footer: with no files, a grouped list's panel fills the view and would push a
                         footer to the bottom of the page -->
                    <StackPanel x:Name="EmptyState">
                        <TextBlock Text="Downloads" Style="{StaticResource HeadingStyle}" />
                        <TextBlock Text="Nothing downloading" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,16" />
                        <!-- nothing queued: what to do, in a dashed drop area -->
                        <Grid CornerRadius="16" Background="{ThemeResource FerrySunkBrush}">
                            <Rectangle RadiusX="16" RadiusY="16" Stroke="{ThemeResource FerryLineStrongBrush}" StrokeThickness="1" StrokeDashArray="4,3" />
                            <StackPanel HorizontalAlignment="Center" Spacing="4" Margin="24,48,24,48">
                                <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE896;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Border>
                                <TextBlock x:Name="EmptyTitle" Text="Paste or drop" Style="{StaticResource SubheadingStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="440"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Paste links in the box at the top (Ctrl+K), or drop links or a .txt of them here." />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnFocusCommandBox">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                            <TextBlock Text="Paste links" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenBrowserButton" Click="OnOpenBrowser">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                                            <TextBlock Text="Open the Browser" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- what it can read now, by what is on -->
                                <services:WrapRow x:Name="EmptyKinds" Spacing="6" MaxWidth="520" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplateSelector>
                <vm:QueueEntryTemplates File="{StaticResource FileTemplate}" Album="{StaticResource AlbumTemplate}" Strip="{StaticResource StripTemplate}" />
            </ListView.ItemTemplateSelector>
        </ListView>

        <!-- what is selected, and what to do with it: over the page's bottom edge -->
        <Border x:Name="SelectionBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18" Padding="16,8,8,8" CornerRadius="14" BorderThickness="1"
                Background="{ThemeResource FerryRaisedBrush}" BorderBrush="{ThemeResource FerryLineStrongBrush}" Visibility="Collapsed" Translation="0,0,24">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="SelectionWords" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="SelectionDetail" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" />
                </StackPanel>
                <Button Click="OnPauseSelected" Height="28" Padding="10,0" FontSize="12" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionPause" Text="Pause" />
                </Button>
                <Button Click="OnRemoveSelected" Height="28" Padding="10,0" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Content="Remove" />
                <Button Style="{StaticResource RowActionStyle}" Click="OnClearSelection" VerticalAlignment="Center" ToolTipService.ToolTip="Clear the selection" AutomationProperties.Name="Clear the selection">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>

        <!-- one file up close -->
        <Border x:Name="Panel" Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <ScrollViewer>
                <StackPanel Padding="16" Spacing="14">
                    <Grid>
                        <Border x:Name="PanelTile" Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left">
                            <FontIcon x:Name="PanelGlyph" FontSize="18" />
                        </Border>
                        <Button Style="{StaticResource RowActionStyle}" HorizontalAlignment="Right" Click="OnClearSelection" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="PanelName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PanelState" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <ProgressBar x:Name="PanelBar" Visibility="Collapsed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PanelPause" HorizontalAlignment="Stretch" Click="OnPanelPause" Height="28" Padding="10,0" FontSize="12" />
                        <Button x:Name="PanelFolder" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnOpenFolder" Content="Folder" Height="28" Padding="10,0" FontSize="12" />
                        <Button Grid.Column="2" Style="{StaticResource RowActionStyle}" Click="OnMore" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Details" Style="{StaticResource CaptionFaintStyle}" />
                        <Grid x:Name="PanelFacts" RowSpacing="7" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
