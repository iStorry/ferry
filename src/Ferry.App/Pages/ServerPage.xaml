<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Ferry.App.Services"
    SizeChanged="OnSizeChanged">
    <!-- docs/mocks/server.html: the crossing, the server right now, the last minute, and its agent's log as a console -->
    <Page.Resources>
        <Style x:Key="LegFigureStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="CharacterSpacing" Value="-12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="GaugeFigureStyle" TargetType="TextBlock" BasedOn="{StaticResource FigureStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="LineHeight" Value="30" />
            <Setter Property="CharacterSpacing" Value="-15" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- what a figure's thin bar fills -->
        <Style x:Key="GaugeTrackStyle" TargetType="Grid">
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FactNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FactValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Text" Value="…" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- the dashes of a leg while data moves along it: two of their lengths, which looks the same at either end -->
        <Storyboard x:Name="SitesFlow" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SitesLine" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-10" Duration="0:0:1.1" EnableDependentAnimation="True" />
        </Storyboard>
        <Storyboard x:Name="HereFlow" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HereLine" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-10" Duration="0:0:1.1" EnableDependentAnimation="True" />
        </Storyboard>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel x:Name="Body" Padding="{StaticResource PagePadding}" Spacing="4">

            <!-- the crossing: from the sites, to the server, to this PC -->
            <Border Style="{StaticResource SetCardStyle}" Padding="20,18,20,20">
                <StackPanel Spacing="20">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ServerName" Style="{StaticResource SubheadingStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <services:WrapRow x:Name="Pills" Spacing="6" />
                            <TextBlock x:Name="Problem" Style="{StaticResource CaptionMutedStyle}" Visibility="Collapsed" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button x:Name="CheckButton" Style="{StaticResource SubtleButtonStyle}" Click="OnCheck" ToolTipService.ToolTip="Ask the server now">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="Check" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TryNowButton" Style="{StaticResource AccentButtonStyle}" Click="OnCheck" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="Try now" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Click="OnOptions" ToolTipService.ToolTip="Server Support's options">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="13" />
                                    <TextBlock Text="Options" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="40" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="40" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="SitesStop" Width="96" Spacing="6">
                            <Border Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="The sites" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                <TextBlock x:Name="SitesSpeed" Style="{StaticResource LegFigureStyle}" />
                                <TextBlock x:Name="SitesUnit" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <Grid Height="8" SizeChanged="OnLegSizeChanged">
                                <Line x:Name="SitesLine" Y1="4" Y2="4" StrokeThickness="2" />
                            </Grid>
                            <TextBlock x:Name="SitesNote" Style="{StaticResource CaptionFaintStyle}" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel x:Name="ServerStop" Grid.Column="2" Width="96" Spacing="6">
                            <Border x:Name="ServerTile" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Center">
                                <FontIcon x:Name="ServerIcon" Glyph="&#xE839;" FontSize="20" />
                            </Border>
                            <TextBlock Text="Your server" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="ServerFree" Style="{StaticResource CaptionMutedStyle}" TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                <TextBlock x:Name="HereSpeed" Style="{StaticResource LegFigureStyle}" />
                                <TextBlock x:Name="HereUnit" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <Grid Height="8" SizeChanged="OnLegSizeChanged">
                                <Line x:Name="HereLine" Y1="4" Y2="4" StrokeThickness="2" />
                            </Grid>
                            <TextBlock x:Name="HereNote" Style="{StaticResource CaptionFaintStyle}" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel x:Name="PcStop" Grid.Column="4" Width="96" Spacing="6">
                            <Border Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE7F8;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="This PC" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="PcFree" Style="{StaticResource CaptionMutedStyle}" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- greyed while these are the last figures, not the server's word now -->
            <StackPanel x:Name="Figures" Spacing="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Right now" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,20,0,4" VerticalAlignment="Center">
                        <TextBlock x:Name="Updated" Style="{StaticResource CaptionFaintStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <ProgressRing x:Name="Busy" Width="12" Height="12" MinWidth="0" MinHeight="0" IsActive="False" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="Gauges" ColumnSpacing="8" RowSpacing="8" />

                <Grid x:Name="Split" ColumnSpacing="8" RowSpacing="8" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition x:Name="SplitSecond" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SetCardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="The last minute" Style="{StaticResource PanelTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle x:Name="GraphKey" Width="12" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center" />
                                    <TextBlock Text="On the server" Style="{StaticResource CaptionMutedStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Coming here" Style="{StaticResource CaptionMutedStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- drawn by DrawGraph -->
                            <Canvas x:Name="Graph" Height="84" SizeChanged="OnGraphSizeChanged">
                                <Polygon x:Name="GraphArea" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18" />
                                <Polyline x:Name="GraphLine" StrokeThickness="1.75" StrokeLineJoin="Round" />
                                <Polyline x:Name="GraphHere" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.75"
                                          StrokeDashArray="2,2" StrokeLineJoin="Round" />
                            </Canvas>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AgentCard" Grid.Column="1" Style="{StaticResource SetCardStyle}" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="The agent" Style="{StaticResource PanelTitleStyle}" />
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Running for" Style="{StaticResource FactNameStyle}" />
                                <TextBlock x:Name="FactUptime" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                                <TextBlock Grid.Row="1" Text="Connected PCs" Style="{StaticResource FactNameStyle}" />
                                <TextBlock x:Name="FactPcs" Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                                <TextBlock Grid.Row="2" Text="Downloading" Style="{StaticResource FactNameStyle}" />
                                <TextBlock x:Name="FactDownloads" Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                                <TextBlock Grid.Row="3" Text="Memory" Style="{StaticResource FactNameStyle}" />
                                <TextBlock x:Name="FactMemory" Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                                <TextBlock Grid.Row="4" Text="Host" Style="{StaticResource FactNameStyle}" />
                                <TextBlock x:Name="FactHost" Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValueStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Log" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Grid.Column="1" Text="The agent's log on the server" Style="{StaticResource CaptionFaintStyle}" Margin="10,20,0,4" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </Grid>
            <!-- ~/.ferry/agent.log as a console: dark in either theme, as a terminal is -->
            <Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="#FF0B0D10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,1" BorderBrush="#12FFFFFF" RequestedTheme="Dark">
                        <Grid Padding="14,4,8,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="#FF9AA3AE" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#FF9AA3AE" FontSize="12" Text="agent.log" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="Connections, files added, finished, brought over, and failures" />
                            <Border Grid.Column="2" Style="{StaticResource SegmentsStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Content="All" GroupName="LogFilter" Style="{StaticResource SegmentItemStyle}" Height="24" IsChecked="True" />
                                    <RadioButton x:Name="LogProblems" Content="Problems" GroupName="LogFilter" Style="{StaticResource SegmentItemStyle}" Height="24"
                                                 Checked="OnLogFilter" Unchecked="OnLogFilter" />
                                </StackPanel>
                            </Border>
                            <ToggleSwitch x:Name="Follow" Grid.Column="3" OnContent="Live" OffContent="Paused" IsOn="True" MinWidth="0"
                                          VerticalAlignment="Center" AutomationProperties.Name="Update the log live" Toggled="OnFollowToggled" />
                            <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="OnRefresh" ToolTipService.ToolTip="Refresh now"
                                    AutomationProperties.Name="Refresh the log now">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Click="OnCopy" ToolTipService.ToolTip="Copy the log"
                                    AutomationProperties.Name="Copy the log">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="196"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                             Foreground="#FFCFD5DC" RequestedTheme="Dark" Padding="14,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="Nothing logged yet" AutomationProperties.Name="Agent log" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
