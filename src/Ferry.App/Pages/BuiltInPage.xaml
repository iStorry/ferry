<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.BuiltInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Ferry.App.Pages"
    SizeChanged="OnSizeChanged">
    <!-- what is part of Ferry, on one page with no switch: what each reads, the few options between them, and what to expect -->
    <ScrollViewer>
        <StackPanel x:Name="PageLayout" Padding="{StaticResource PagePadding}" Spacing="4">
            <pages:PluginHeader x:Name="Header" />

            <TextBlock Text="What Ferry reads by itself" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SetCardStyle}"><StackPanel x:Name="Readers" /></Border>

            <StackPanel x:Name="OptionsGroup" Spacing="4">
                <TextBlock Text="Options" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SetCardStyle}"><StackPanel x:Name="Rows" /></Border>
            </StackPanel>

            <StackPanel x:Name="LimitsGroup" Spacing="4">
                <TextBlock Text="Good to know" Style="{StaticResource SectionHeaderStyle}" />
                <Border CornerRadius="12" Padding="14,12" BorderThickness="1" Background="{ThemeResource FerrySunkBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel x:Name="Limits" Grid.Column="1" Spacing="6" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
