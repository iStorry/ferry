<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
    <!-- docs/mocks/plugins.html: what is built in, then the plugins with their switches, on the left; the one chosen on the right -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="348" />
            <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,24,16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Plugins" Style="{StaticResource HeadingStyle}" />
                        <TextBlock Text="Extras to turn on when you want them. Everyday links work without any." Style="{StaticResource CaptionMutedStyle}" />
                        <Grid ColumnSpacing="8" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FindBox" PlaceholderText="Find a plugin, or a site" TextChanged="OnFindChanged"
                                     AutomationProperties.Name="Find a plugin, or a site" />
                            <Button x:Name="AddButton" Grid.Column="1" ToolTipService.ToolTip="Add a plugin" AutomationProperties.Name="Add a plugin">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="From a file…" Click="OnAddFromFile" />
                                        <MenuFlyoutItem Text="From a link…" Click="OnAddFromLink" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource SegmentsStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="AllTab" GroupName="PluginTabs" Style="{StaticResource SegmentItemStyle}" HorizontalAlignment="Stretch" IsChecked="True" Click="OnTab" />
                                <RadioButton x:Name="OnlyOnTab" Grid.Column="1" GroupName="PluginTabs" Style="{StaticResource SegmentItemStyle}" HorizontalAlignment="Stretch" Click="OnTab" />
                                <RadioButton x:Name="OnlyOffTab" Grid.Column="2" GroupName="PluginTabs" Style="{StaticResource SegmentItemStyle}" HorizontalAlignment="Stretch" Click="OnTab" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <ListView x:Name="List" Grid.Row="1" Padding="8,4,8,16" SelectionMode="Single" SelectionChanged="OnChosen"
                          ItemContainerStyle="{StaticResource PlainListItemStyle}" AutomationProperties.Name="Plugins" />
            </Grid>
        </Border>

        <Frame x:Name="Detail" Grid.Column="1" />
    </Grid>
</Page>
