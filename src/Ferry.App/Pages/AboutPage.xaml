<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
    <!-- docs/mocks/about.html: reached from Settings; what version it is, and whether a newer one is out -->
    <ScrollViewer>
        <StackPanel x:Name="PageLayout" Padding="{StaticResource PagePadding}" Spacing="4">
            <Button x:Name="BackToSettings" Style="{StaticResource SubtleButtonStyle}" Margin="-8,0,0,12" Click="OnBackToSettings">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    <TextBlock Text="Settings" FontSize="12" />
                </StackPanel>
            </Button>

            <Grid ColumnSpacing="20" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="80" Height="80" CornerRadius="22">
                    <Border.Background>
                        <ImageBrush ImageSource="ms-appx:///Assets/AppIcon.png" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ferry" FontSize="36" LineHeight="44" FontWeight="SemiBold" CharacterSpacing="-24" OpticalMarginAlignment="None" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="UpdateTile" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="UpdateIcon" Glyph="&#xE895;" FontSize="18" />
                            <ProgressRing x:Name="UpdateRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateDetail" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="UpdateButtons" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                    <ProgressBar x:Name="UpdateProgress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Maximum="1" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <TextBlock Text="More" Style="{StaticResource SectionHeaderStyle}" />
            <Grid x:Name="LinkCards" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Style="{StaticResource CardButtonStyle}" VerticalAlignment="Stretch" Padding="14" Tag="https://github.com/iStorry/ferry" Click="OnLink"
                        AutomationProperties.Name="Source code on GitHub">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Source code" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="github.com/iStorry/ferry" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="github.com/iStorry/ferry" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" VerticalAlignment="Stretch" Padding="14" Tag="https://github.com/iStorry/ferry/blob/main/LICENSE" Click="OnLink"
                        AutomationProperties.Name="License">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="License" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="MIT" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Button>
                <!-- the notices have no page of their own to open, so they open here -->
                <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" VerticalAlignment="Stretch" Padding="14" AutomationProperties.Name="Third-party notices">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="8" MinWidth="320">
                                <Grid><TextBlock Text="OpenSSH (Win32-OpenSSH), in openssh\" /><TextBlock Text="BSD" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                <Grid><TextBlock Text="Windows App SDK" /><TextBlock Text="MIT" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                <Grid><TextBlock Text=".NET runtime" /><TextBlock Text="MIT" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Third-party notices" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="OpenSSH, .NET, Windows App SDK" Style="{StaticResource CaptionMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="OpenSSH, .NET, Windows App SDK" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
