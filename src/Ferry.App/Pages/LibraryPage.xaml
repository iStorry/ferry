<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ferry.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
    <!-- what is in a folder of yours, each by its name and version, and how it stands against what a plugin's site lists -->
    <ScrollViewer>
        <StackPanel x:Name="PageLayout" Padding="{StaticResource PagePadding}" Spacing="4">
            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Library" Style="{StaticResource HeadingStyle}" />
                    <TextBlock x:Name="Count" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" Margin="0,4,0,0" />
                    <ProgressRing x:Name="Reading" Width="14" Height="14" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox x:Name="FindBox" Grid.Column="1" Width="200" VerticalAlignment="Center" PlaceholderText="Find by name" TextChanged="OnFindChanged" AutomationProperties.Name="Find by name" />
                <Button x:Name="RefreshButton" Grid.Column="2" Click="OnRefresh" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="Read the folder again" ToolTipService.ToolTip="Read the folder again">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" Click="OnChooseFolder" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="Choose the folder" ToolTipService.ToolTip="Choose the folder">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" Click="OnSettings" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="The plugin's settings" ToolTipService.ToolTip="The plugin's settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </Grid>
            <InfoBar x:Name="Problem" IsClosable="True" IsOpen="False" Severity="Error" Margin="0,0,0,8" />

            <!-- how the update check on the server goes, quietly -->
            <TextBlock x:Name="CheckLine" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" Margin="2,0,0,6" Visibility="Collapsed" />
            <Border x:Name="GamesCard" Style="{StaticResource SetCardStyle}"><StackPanel x:Name="GameRows" /></Border>

            <StackPanel x:Name="EmptyPanel" Spacing="10" Margin="2,4,0,0" Visibility="Collapsed">
                <TextBlock x:Name="Empty" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
                <Button x:Name="SettingsLink" Content="Choose the folder" Click="OnChooseFolder" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
