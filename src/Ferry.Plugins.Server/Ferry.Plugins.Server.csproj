  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ferry.Core\Ferry.Core.csproj" />
    <!-- the agent downloads from every site the PC can -->
    <ProjectReference Include="..\Ferry.Plugins.Official\Ferry.Plugins.Official.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ferry.Core.Tests" />
  </ItemGroup>

</Project>
