<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- LibraryImport (source-generated P/Invoke, AOT-safe): the job that ends ssh with the app, the terminal's size -->
